{
  "name": "pyflow-ts-codegen",
  "version": "0.1.0",
  "description": "PyFlow.ts project for codegen",
  "type": "module",
  "scripts": {
    "start-server": "pyflow run -m ../backend/codegen --port 8000",
    "start-ts": "tsc --watch",
    "start": "concurrently \"npm run start-server\" \"npm run start-ts\"",
    "build": "tsc",
    "serve": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts"
  },
  "dependencies": {
    "node-fetch": "^3.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  }
}